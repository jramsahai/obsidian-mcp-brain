{
  "name": "obsidian-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing intent-shaped tools over the Obsidian second-brain vault",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/obsidian-mcp.mjs --banner:js=\"#!/usr/bin/env node\"",
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit",
    "lint:vault": "node scripts/lint-vault-docs.ts",
    "evals": "node evals/run.ts",
    "reject-rate": "node scripts/reject-rate.ts",
    "calibrate": "node scripts/calibrate-similarity.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.1.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
